# Servidor
PORT=3000
NODE_ENV=development

# CORS — separe múltiplas origens com vírgula (usado apenas em produção)
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=substitua-por-um-segredo-forte
JWT_REFRESH_SECRET=substitua-por-outro-segredo-forte
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/auth_api?schema=public"
